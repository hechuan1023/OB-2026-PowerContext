# seekdb（MySQL 协议，Docker 容器默认无密码）
LITMEMO_SEEKDB_HOST=127.0.0.1
LITMEMO_SEEKDB_PORT=2881
LITMEMO_SEEKDB_TENANT=sys
LITMEMO_SEEKDB_DATABASE=test
LITMEMO_SEEKDB_USER=root
LITMEMO_SEEKDB_PASSWORD=
LITMEMO_COLLECTION_NAME=litmemo_chunks

# 本地中文向量模型，无需任何 API Key
LITMEMO_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LITMEMO_EMBEDDING_DIMENSION=512
# HuggingFace 访问受限时使用的镜像
HF_ENDPOINT=https://hf-mirror.com

# PowerContext Server
LITMEMO_POWERCONTEXT_URL=http://127.0.0.1:8000
LITMEMO_POWERCONTEXT_TOKEN=
# 留空则使用 Server 的 default scope
LITMEMO_POWERCONTEXT_SCOPE_ID=

LITMEMO_HOST=127.0.0.1
LITMEMO_PORT=8080
