{
  "name": "stepfun-local-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "models": "node scripts/download-models.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node scripts/integration.js",
    "bench": "node scripts/browser-bench.js",
    "db:up": "docker compose up -d --wait"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "express": "5.1.0",
    "seekdb": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "vite": "7.2.2"
  }
}
